# URL công khai của website (dùng cho thẻ chia sẻ và hreflang)
NEXT_PUBLIC_SITE_URL=https://ten-mien-cua-ban.vn

# Để Google lập chỉ mục website, đổi thành true SAU KHI đã điền hết nội dung thật.
# Mặc định là false: website gắn "noindex" để không lộ bản chưa hoàn thiện.
NEXT_PUBLIC_ALLOW_INDEX=false

# Form liên hệ gửi qua Resend (https://resend.com). Không điền thì form báo
# "chưa cấu hình" và hướng dẫn khách email trực tiếp.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Ví dụ: "Portfolio <onboarding@resend.dev>" (dùng tạm) hoặc địa chỉ trên tên miền đã xác minh
CONTACT_FROM_EMAIL=
